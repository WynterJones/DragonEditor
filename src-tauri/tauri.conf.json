{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DragonEditor",
  "version": "0.1.0",
  "identifier": "com.monetizedesign.dragoneditor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "DragonEditor",
        "width": 724,
        "height": 543,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      },
      {
        "label": "main",
        "title": "DragonEditor",
        "width": 1480,
        "height": 920,
        "minWidth": 1100,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "/Volumes/**", "/tmp/**", "/private/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/ffmpeg", "binaries/ffprobe"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Video",
    "shortDescription": "A bespoke video editor with ElevenLabs voice built in",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "Developer ID Application: Wynter Jones (7X2UF4FZHC)",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM5N0M4NkQ4MDYyRDVDQzQKUldURVhDMEcySVo4T1FYaXE1WSsweHZVa25JeGcrcit1MzhaM0ErNmI2ZTFZMVJwVEEvYTdNcW0K",
      "endpoints": ["https://github.com/WynterJones/DragonEditor/releases/latest/download/latest.json"]
    }
  }
}
